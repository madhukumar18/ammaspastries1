APP_NAME="Ammas Pastries"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL for Production & Localhost)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ammas_pastries
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative for zero-configuration testing:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Razorpay Payment Gateway (Test Mode for Local, Live Mode for Production)
RAZORPAY_KEY_ID=rzp_test_demokey12345
RAZORPAY_KEY_SECRET=test_secret_12345
RAZORPAY_WEBHOOK_SECRET=

# Mail Configuration (Logs to storage/logs/laravel.log during local testing)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="care@ammaspastries.in"
MAIL_FROM_NAME="${APP_NAME}"
