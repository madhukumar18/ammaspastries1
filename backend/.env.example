APP_NAME="Ammas Pastries"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Default is MySQL (e.g. XAMPP / WampServer / local MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ammas_pastries
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative for zero-configuration setup:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Google Maps / Geocoding API Key (for store locator & distance calculation)
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Rista POS (DotPe) Integration
RISTA_API_BASE_URL=https://api.ristaapps.com/v1
RISTA_API_KEY=your_rista_api_key_here
RISTA_API_SECRET=your_rista_api_secret_here
RISTA_API_TOKEN=
RISTA_AUTO_SYNC=true
RISTA_DEFAULT_BRANCH_CODE=Test
RISTA_DEFAULT_BRANCH_NAME=Test
RISTA_SSL_VERIFY=false

# Mail Configuration (Logs to storage/logs/laravel.log during local testing)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="care@ammaspastries.in"
MAIL_FROM_NAME="${APP_NAME}"
